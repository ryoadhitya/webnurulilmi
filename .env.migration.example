# Contoh berkas kredensial migrasi Supabase.
#
# Salin menjadi `.env.migration` di akar project lalu isi nilainya.
# `.env.migration` sudah masuk .gitignore — JANGAN pernah di-commit.
#
# Buatkan Personal Access Token di:
#   https://supabase.com/dashboard/account/tokens
#
# Ambil Project URL, anon key, dan service_role key dari:
#   Supabase Dashboard > project "nurul ilmi bekasi" > Settings > API
#
#   anon/publishable key  -> aman untuk frontend (masuk js/site-config.js)
#   service_role key      -> HANYA untuk script migrasi. JANGAN pernah
#                            ditulis ke file HTML/JS mana pun.

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx

# Bucket Storage untuk media artikel & fasilitas.
SUPABASE_STORAGE_BUCKET=media

# Password sementara untuk admin@ypinurulilmi.or.id (Butir 5).
# Kosongkan bila ingin akun dibuat tanpa password (reset lewat email).
SUPABASE_ADMIN_PASSWORD=
SUPABASE_ADMIN_ROLE=admin
